<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="clinic_management.ClinicDashboard" owl="1">
        <div class="o_clinic_dashboard p-4">
            <div class="d-flex align-items-center justify-content-between">
                <h1 t-esc="state.title" class="mb-0"/>
                <div class="d-flex align-items-center gap-3">
                    <!-- Notification Bell Dropdown -->
                    <div class="position-relative">
                        <button class="btn btn-link text-dark position-relative p-2" type="button" t-on-click="toggleNotificationsDropdown">
                            <i class="fa fa-bell fs-4"/>
                            <span t-if="state.unreadCount > 0" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                <t t-esc="state.unreadCount"/>
                            </span>
                        </button>
                        
                        <!-- Dropdown Menu -->
                        <div t-if="state.showNotificationsDropdown" class="position-absolute end-0 mt-2 bg-white border rounded shadow-lg p-0" style="width: 320px; z-index: 1050;">
                            <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                                <span class="fw-bold text-dark">Upcoming Appointments</span>
                                <button t-if="state.unreadCount > 0" class="btn btn-link btn-sm p-0 text-primary fw-semibold text-decoration-none" type="button" t-on-click="markAllRead">
                                    Mark All Read
                                </button>
                            </div>
                            <div class="overflow-auto" style="max-height: 250px;">
                                <t t-if="state.notifications.length === 0">
                                    <div class="text-center text-muted p-4 small">
                                        No upcoming appointments in the next 2 hours.
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="state.notifications" t-as="noti" t-key="noti.id">
                                            <div class="list-group-item p-3 list-group-item-action border-0 border-bottom text-dark">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <span class="small fw-bold text-dark" t-esc="noti.name"/>
                                                    <span class="badge rounded-pill bg-info text-dark small" style="font-size: 0.7rem;" t-esc="noti.remainingStr"/>
                                                </div>
                                                <div class="small text-muted mt-1">
                                                    <div><strong>Patient:</strong> <span t-esc="noti.patient_id ? noti.patient_id[1] : '-'"/></div>
                                                    <div><strong>Doctor:</strong> <span t-esc="noti.doctor_id ? noti.doctor_id[1] : '-'"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-primary" type="button" t-on-click="loadDashboardData">
                        Refresh
                    </button>
                    <button class="btn btn-primary" type="button" t-on-click="openAppointmentModal">
                        New Appointment
                    </button>
                </div>
            </div>

            <div t-if="state.isLoading" class="alert alert-info mt-4">
                Loading dashboard data...
            </div>

            <div t-if="state.error" class="alert alert-danger mt-4" t-esc="state.error"/>

            <div class="row mt-4">
                <div class="col-12 col-md-6 col-xl mb-3">
                    <div class="card p-3">
                        <span class="text-muted">Total Patients</span>
                        <strong class="fs-2" t-esc="state.patientCount"/>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl mb-3">
                    <div class="card p-3">
                        <span class="text-muted">Total Appointments</span>
                        <strong class="fs-2" t-esc="state.totalAppointments"/>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl mb-3">
                    <div class="card p-3">
                        <span class="text-muted">Confirmed</span>
                        <strong class="fs-2" t-esc="state.confirmedAppointments"/>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl mb-3">
                    <div class="card p-3">
                        <span class="text-muted">Done</span>
                        <strong class="fs-2" t-esc="state.doneAppointments"/>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl mb-3">
                    <div class="card p-3">
                        <span class="text-muted">Cancelled</span>
                        <strong class="fs-2" t-esc="state.cancelledAppointments"/>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Recent Appointments</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>State</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.recentAppointments.length">
                                <td colspan="5" class="text-center text-muted py-4">
                                    No recent appointments found.
                                </td>
                            </tr>
                            <tr t-foreach="state.recentAppointments" t-as="appointment" t-key="appointment.id">
                                <td t-esc="appointment.patient_id ? appointment.patient_id[1] : '-'"/>
                                <td t-esc="appointment.doctor_id ? appointment.doctor_id[1] : '-'"/>
                                <td t-esc="appointment.appointment_date || '-'"/>
                                <td>
                                    <span class="badge text-bg-secondary" t-esc="appointment.state"/>
                                </td>
                                <td class="text-end">
                                    <button
                                        t-if="appointment.state === 'draft'"
                                        class="btn btn-sm btn-primary"
                                        type="button"
                                        t-att-disabled="state.confirmingAppointmentId === appointment.id"
                                        t-on-click="() => this.confirmAppointment(appointment.id)"
                                    >
                                        Confirm
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <AppointmentModal t-if="state.isModalOpen" onClose="() => this.closeAppointmentModal()" onAppointmentCreated="() => this.loadDashboardData()"/>
        </div>
    </t>
</templates>
