<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="clinic_management.ClinicKanban" owl="1">
        <div class="o_clinic_kanban p-4 bg-light min-vh-100">
            <!-- Kanban Header -->
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
                <div>
                    <h1 class="h3 text-dark fw-bold mb-1">Appointment Board</h1>
                    <p class="text-muted small mb-0">Manage and track all clinic appointments across their lifecycles.</p>
                </div>
                
                <!-- Search and Action Controls -->
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group shadow-sm" style="max-width: 300px;">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa fa-search text-muted"/>
                        </span>
                        <input type="text" 
                               class="form-control border-start-0 ps-0 text-dark" 
                               placeholder="Search patient name..." 
                               t-model="state.searchQuery"/>
                    </div>
                    <button class="btn btn-primary shadow-sm" type="button" t-on-click="loadAppointments">
                        <i class="fa fa-refresh me-1"/> Refresh Board
                    </button>
                </div>
            </div>

            <!-- Kanban Columns -->
            <div class="row g-3">
                <!-- Draft Column -->
                <div class="col-12 col-md-3">
                    <div class="kanban-column bg-white rounded-3 shadow-sm border p-3 min-vh-75">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-2">
                            <h5 class="fw-bold mb-0 text-secondary">Draft</h5>
                            <span class="badge rounded-pill bg-secondary text-white" t-esc="draft.length"/>
                        </div>
                        <div class="kanban-cards-container">
                            <t t-foreach="draft" t-as="appt" t-key="appt.id">
                                <div class="card mb-3 border-0 border-start border-secondary border-4 shadow-sm hover-card">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark mb-2" t-esc="appt.name"/>
                                        <div class="small text-muted mb-3">
                                            <div class="mb-1"><i class="fa fa-user me-2 text-secondary"/> <strong class="text-dark">Patient:</strong> <span t-esc="appt.patient_id ? appt.patient_id[1] : '-'"/></div>
                                            <div class="mb-1"><i class="fa fa-user-md me-2 text-secondary"/> <strong class="text-dark">Doctor:</strong> <span t-esc="appt.doctor_id ? appt.doctor_id[1] : '-'"/></div>
                                            <div><i class="fa fa-calendar me-2 text-secondary"/> <span t-esc="appt.formatted_date || '-'"/></div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary w-100" type="button" t-on-click="() => this.moveForward(appt)">
                                            Move Forward <i class="fa fa-arrow-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </t>
                            <div t-if="!draft.length" class="text-center text-muted py-4 small">
                                No draft appointments
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Confirmed Column -->
                <div class="col-12 col-md-3">
                    <div class="kanban-column bg-white rounded-3 shadow-sm border p-3 min-vh-75">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-info border-2">
                            <h5 class="fw-bold mb-0 text-info">Confirmed</h5>
                            <span class="badge rounded-pill bg-info text-white" t-esc="confirmed.length"/>
                        </div>
                        <div class="kanban-cards-container">
                            <t t-foreach="confirmed" t-as="appt" t-key="appt.id">
                                <div class="card mb-3 border-0 border-start border-info border-4 shadow-sm hover-card">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark mb-2" t-esc="appt.name"/>
                                        <div class="small text-muted mb-3">
                                            <div class="mb-1"><i class="fa fa-user me-2 text-info"/> <strong class="text-dark">Patient:</strong> <span t-esc="appt.patient_id ? appt.patient_id[1] : '-'"/></div>
                                            <div class="mb-1"><i class="fa fa-user-md me-2 text-info"/> <strong class="text-dark">Doctor:</strong> <span t-esc="appt.doctor_id ? appt.doctor_id[1] : '-'"/></div>
                                            <div><i class="fa fa-calendar me-2 text-info"/> <span t-esc="appt.formatted_date || '-'"/></div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-info w-100" type="button" t-on-click="() => this.moveForward(appt)">
                                            Move Forward <i class="fa fa-arrow-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </t>
                            <div t-if="!confirmed.length" class="text-center text-muted py-4 small">
                                No confirmed appointments
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Done Column -->
                <div class="col-12 col-md-3">
                    <div class="kanban-column bg-white rounded-3 shadow-sm border p-3 min-vh-75">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-success border-2">
                            <h5 class="fw-bold mb-0 text-success">Done</h5>
                            <span class="badge rounded-pill bg-success text-white" t-esc="done.length"/>
                        </div>
                        <div class="kanban-cards-container">
                            <t t-foreach="done" t-as="appt" t-key="appt.id">
                                <div class="card mb-3 border-0 border-start border-success border-4 shadow-sm hover-card">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark mb-2" t-esc="appt.name"/>
                                        <div class="small text-muted">
                                            <div class="mb-1"><i class="fa fa-user me-2 text-success"/> <strong class="text-dark">Patient:</strong> <span t-esc="appt.patient_id ? appt.patient_id[1] : '-'"/></div>
                                            <div class="mb-1"><i class="fa fa-user-md me-2 text-success"/> <strong class="text-dark">Doctor:</strong> <span t-esc="appt.doctor_id ? appt.doctor_id[1] : '-'"/></div>
                                            <div><i class="fa fa-calendar me-2 text-success"/> <span t-esc="appt.formatted_date || '-'"/></div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div t-if="!done.length" class="text-center text-muted py-4 small">
                                No completed appointments
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cancelled Column -->
                <div class="col-12 col-md-3">
                    <div class="kanban-column bg-white rounded-3 shadow-sm border p-3 min-vh-75">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-danger border-2">
                            <h5 class="fw-bold mb-0 text-danger">Cancelled</h5>
                            <span class="badge rounded-pill bg-danger text-white" t-esc="cancelled.length"/>
                        </div>
                        <div class="kanban-cards-container">
                            <t t-foreach="cancelled" t-as="appt" t-key="appt.id">
                                <div class="card mb-3 border-0 border-start border-danger border-4 shadow-sm hover-card">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark mb-2" t-esc="appt.name"/>
                                        <div class="small text-muted">
                                            <div class="mb-1"><i class="fa fa-user me-2 text-danger"/> <strong class="text-dark">Patient:</strong> <span t-esc="appt.patient_id ? appt.patient_id[1] : '-'"/></div>
                                            <div class="mb-1"><i class="fa fa-user-md me-2 text-danger"/> <strong class="text-dark">Doctor:</strong> <span t-esc="appt.doctor_id ? appt.doctor_id[1] : '-'"/></div>
                                            <div><i class="fa fa-calendar me-2 text-danger"/> <span t-esc="appt.formatted_date || '-'"/></div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div t-if="!cancelled.length" class="text-center text-muted py-4 small">
                                No cancelled appointments
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>